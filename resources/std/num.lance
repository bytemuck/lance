Numeric :: type -> type
Numeric T = {
    (+) :: T -> T -> T
  , (-) :: T -> T -> T
  , (*) :: T -> T -> T
}

Integral :: type -> type
Integral T = {
    (//) :: T -> T -> T
}

Fractional :: type -> type
Fractional T = {
    (/) :: T -> T -> T
}

Eq :: type -> type
Eq T = {
    (==) :: T -> T -> bool
  , (!=) :: T -> T -> bool
}

Ord :: type -> type
Ord T = {
    (<) :: T -> T -> bool
  , (<=) :: T -> T -> bool
  , (>) :: T -> T -> bool
  , (>=) :: T -> T -> bool
}

Numeric i8 :: type
Numeric i8 = .{
    (+) = @builtin_add
  , (-) = @builtin_sub
  , (*) = @builtin_mul
}

Eq i8 = .{
    (==) = @builtin_eq
  , (!=) = @builtin_neq
}

Ord i8 = .{
    (<) = @builtin_lt
  , (<=) = @builtin_lte
  , (>) = @builtin_gt
  , (>=) = @builtin_gte
}

Integral :: type
Integral i8 = {
    (//) :: @builtin_div
}

