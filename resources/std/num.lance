Numeric :: type -> type
Numeric T = {
    (+) :: T -> T -> T
  , (-) :: T -> T -> T
  , (*) :: T -> T -> T
}

Integral :: type -> type
Integral T = {
    (//) :: T -> T -> T
}

Fractional :: type -> type
Fractional T = {
    (/) :: T -> T -> T
}

Eq :: type -> type
Eq T = {
    (==) :: T -> T -> bool
  , (!=) :: T -> T -> bool
}

Ord :: type -> type
Ord T = {
    (<) :: T -> T -> bool
  , (<=) :: T -> T -> bool
  , (>) :: T -> T -> bool
  , (>=) :: T -> T -> bool
}

Numeric i8 :: type
Numeric i8 = .{
    (+) = +#
  , (-) = -#
  , (*) = *#
}

Eq i8 = .{
    (==) = ==#
  , (!=) = !=#
}

Ord i8 = .{
    (<) = <#
  , (<=) = <=#
  , (>) = >#
  , (>=) = >=#
}

Integral i8 :: type
Integral i8 = .{
    (//) = //#
}

