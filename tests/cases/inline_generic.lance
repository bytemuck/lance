import "bool.lance"

-- An inline function is expanded per specialization, and can use another inline function.
unless :: bool -> lazy T -> lazy T -> inline T
unless condition whenFalse whenTrue = if condition whenTrue whenFalse

-- expect: 5
-- expect: 1.500000
-- expect: ()
main :: ()
main = let a = print (unless true (//# 1 0) 5) in print (unless false 1.5 2.5)
