import "num.lance"

Vec :: type -> type
Vec T = {
    x :: T
  , y :: T
}

Vec2 :: type
Vec2 = Vec f32

newVec :: f32 -> f32 -> Vec2
newVec x y = .{
    x = x
  , y = y
}

addVec :: Vec2 -> Vec2 -> Vec2
addVec a b = .{
    x = + a.x b.x
  , y = + a.y b.y
}

p1 :: Vec2
p1 = newVec 1.0 2.0

p2 :: Vec2
p2 = newVec 3.0 4.0

-- expect: 6.000000
main :: f32
main = (addVec p1 p2).y
