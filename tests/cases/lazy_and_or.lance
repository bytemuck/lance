import "bool.lance"

-- The second operand is only evaluated when it decides the result.
safe :: bool
safe = and false (==# (//# 1 0) 0)

alsoSafe :: bool
alsoSafe = or true (==# (//# 1 0) 0)

-- expect: false
-- expect: true
-- expect: true
-- expect: ()
main :: ()
main =
    let a = print safe
        b = print alsoSafe
    in print (not (and true false))
