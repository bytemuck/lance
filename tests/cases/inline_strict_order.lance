-- Strict arguments are evaluated once each, in call order, even when the body ignores or reuses them.
first :: i32 -> i32 -> inline i32
first a b = a

double :: i32 -> inline i32
double x = +# x x

-- expect: a
-- expect: b
-- expect: once
-- expect: 9
main :: i32
main = +# (first (let u = print "a" in 1) (let v = print "b" in 2)) (double (let w = print "once" in 4))
