Shape :: type -> type
Shape T = {
    area :: T -> f32
}

Circle :: type
Circle = { r :: f32 }

circleArea :: Circle -> f32
circleArea c = *# c.r c.r

Shape Circle :: type
Shape Circle = .{
    area = circleArea
}

describe :: (Shape T) => T -> f32
describe s = T.area s

unit :: Circle
unit = .{ r = 3.0 }

-- expect: 9.000000
main :: f32
main = describe unit
